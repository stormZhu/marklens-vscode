{
  "name": "marklens",
  "displayName": "MarkLens",
  "description": "Interactive code-aware Markdown preview & custom editor for VSCode — automatic file-path detection & floating code preview card, code/table headers, KaTeX math, Mermaid diagrams, Lightbox zoom, TOC dock, table row modal, 36 themes, and standalone HTML export.",
  "version": "0.1.2",
  "publisher": "marklens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stormZhu/marklens-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "marklens",
    "mermaid",
    "katex",
    "code-link-preview"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCustomEditor:marklens.markdownPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "marklens.markdownPreview",
        "displayName": "MarkLens Markdown Preview",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkd}"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "marklens.togglePreview",
        "title": "MarkLens: Toggle Preview / Source Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "marklens.openPreview",
        "title": "MarkLens: Open Markdown Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "marklens.showSource",
        "title": "MarkLens: Switch to Source Editor",
        "icon": "$(code)"
      },
      {
        "command": "marklens.toggleViewMode",
        "title": "MarkLens: Toggle Rendered / Raw View in Preview",
        "icon": "$(eye)"
      },
      {
        "command": "marklens.openPreviewToSide",
        "title": "MarkLens: Open Markdown Preview to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "marklens.selectTheme",
        "title": "MarkLens: Select Markdown Preview Theme"
      },
      {
        "command": "marklens.exportHtml",
        "title": "MarkLens: Export Markdown as Standalone HTML"
      },
      {
        "command": "marklens.toggleToc",
        "title": "MarkLens: Toggle Markdown Outline (TOC)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marklens.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "marklens.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "marklens.showSource",
          "when": "activeCustomEditorId == 'marklens.markdownPreview'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "marklens.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@15"
        },
        {
          "command": "marklens.openPreviewToSide",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@16"
        }
      ]
    },
    "keybindings": [
      {
        "command": "marklens.togglePreview",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown || activeCustomEditorId == 'marklens.markdownPreview' || activeWebviewPanelId == 'marklens.markdownSidePreview'"
      },
      {
        "command": "marklens.toggleViewMode",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "activeCustomEditorId == 'marklens.markdownPreview' || activeWebviewPanelId == 'marklens.markdownSidePreview'"
      },
      {
        "command": "marklens.openPreviewToSide",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "MarkLens",
      "properties": {
        "marklens.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "one-light",
            "ayu-light",
            "github-light",
            "light-modern",
            "light-plus",
            "quiet-light",
            "vitesse-light",
            "bluloco-light",
            "material-lighter",
            "alabaster",
            "everforest-light",
            "high-contrast-light",
            "nord-light",
            "catppuccin-latte",
            "solarized-light",
            "gruvbox-light",
            "solarized-dark",
            "monokai",
            "material-darker",
            "dark-plus",
            "bluloco-dark",
            "nord",
            "everforest-dark",
            "one-dark-pro",
            "dracula",
            "rose-pine",
            "gruvbox-dark",
            "solarized-deep",
            "github-dark",
            "catppuccin-mocha",
            "vitesse-dark",
            "tokyo-night",
            "kanagawa",
            "ayu-dark",
            "night-owl",
            "high-contrast-dark"
          ],
          "description": "Color theme for MarkLens Markdown Preview. Set to 'auto' to automatically follow VSCode Light/Dark theme."
        },
        "marklens.tableRowExpand": {
          "type": "boolean",
          "default": false,
          "description": "Enable clicking markdown table rows to show expanded row details in a modal. Default is false."
        },
        "marklens.selectionToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show floating action pill (Add to chat, Edit source, Copy) when selecting text in markdown preview. Default is true."
        }
      }
    }
  },
  "scripts": {
    "build:extension": "esbuild src/extension/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "build:webview": "vite build",
    "build": "npm run build:extension && npm run build:webview",
    "package:vsix": "npm run build && node scripts/package-vsix.mjs",
    "install:local": "npm run package:vsix && node scripts/install-extension.mjs",
    "install:trae": "npm run package:vsix && node scripts/install-extension.mjs trae",
    "install:code": "npm run package:vsix && node scripts/install-extension.mjs code",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.8",
    "diff": "^9.0.0",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.14",
    "material-icon-theme": "^5.36.1",
    "mermaid": "^11.14.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
